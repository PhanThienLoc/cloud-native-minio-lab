# MinIO Server Configuration (Root Account)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-minio-password

# Application S3 endpoint
ENDPOINT_URL=http://localhost:9000
# Optional application credentials. If omitted, the Python clients use the
# MinIO root credentials above as a fallback for this local lab.
# AWS_ACCESS_KEY_ID=change-me-app-user
# AWS_SECRET_ACCESS_KEY=change-me-app-password

# Week 3 data ingestion defaults
INGESTION_SOURCE_DIR=scripts/sample_data
INGESTION_BUCKET=raw-data
DATA_SOURCE_ID=sensor-01

# Grafana administrator account for the local lab.
GF_SECURITY_ADMIN_USER=change-me-grafana-admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password
